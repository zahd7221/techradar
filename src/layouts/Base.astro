---
const { title = 'TechRadar' } = Astro.props;
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root { --fg:#1a1a1a; --muted:#555; --accent:#2563eb; --bg:#fafafa; --card:#fff; --border:#e5e7eb; }
      * { box-sizing: border-box; }
      body { margin:0; font-family: system-ui, 'Segoe UI', Tahoma, sans-serif; background:var(--bg); color:var(--fg); line-height:1.7; }
      header { background:var(--card); border-bottom:1px solid var(--border); padding:1rem 1.5rem; }
      header h1 { margin:0; font-size:1.5rem; color:var(--accent); }
      main { max-width:900px; margin:2rem auto; padding:0 1rem; }
      article { background:var(--card); border:1px solid var(--border); border-radius:12px; padding:1.5rem; margin-bottom:1.5rem; }
      article h2 { margin-top:0; }
      article h2 a { color:var(--fg); text-decoration:none; }
      article h2 a:hover { color:var(--accent); }
      .meta { color:var(--muted); font-size:.85rem; }
      .tag { display:inline-block; background:#eef2ff; color:var(--accent); padding:.15rem .5rem; border-radius:6px; font-size:.75rem; margin-inline-end:.5rem; }
      footer { text-align:center; color:var(--muted); padding:2rem; font-size:.85rem; }
      a { color:var(--accent); }
    </style>
  </head>
  <body>
    <header><h1>📡 TechRadar</h1><p style="margin:.25rem 0 0;color:var(--muted);font-size:.9rem;">أخبار الذكاء الاصطناعي + أدوات مفتوحة المصدر (يومياً)</p></header>
    <main><slot /></main>
    <footer>TechRadar — محتوى مُولَّد آلياً مع مصادر. OSS/مجاني 100%.</footer>
  </body>
</html>
